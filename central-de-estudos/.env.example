# =============================================================================
# CENTRAL DE ESTUDOS — variáveis de ambiente do FRONTEND
# Copie para `.env.local` (desenvolvimento) ou cadastre na Netlify
# (Site configuration → Environment variables).
# =============================================================================

# URL do projeto Supabase (Project Settings → Data API → Project URL)
VITE_SUPABASE_URL=

# Chave PÚBLICA do Supabase: "publishable key" (sb_publishable_...) ou a antiga
# "anon key". Ela é pública por natureza e protegida pelas políticas RLS.
# NUNCA coloque aqui a service_role / secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Sem as duas variáveis acima, o app roda em MODO LOCAL (IndexedDB, só neste navegador).

# -----------------------------------------------------------------------------
# Integração com IA (Fase 7) — configurada SOMENTE no backend (Netlify Functions).
# NÃO use o prefixo VITE_ (variáveis VITE_ são embutidas no navegador).
# ANTHROPIC_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# -----------------------------------------------------------------------------
