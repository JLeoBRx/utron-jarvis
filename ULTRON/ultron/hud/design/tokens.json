{
  "_sobre": "Fonte única da identidade visual do JARVIS (desktop Qt, cena 3D, ORBE e web). Gere o CSS com: python tools/gerar_tokens.py",
  "color": {
    "space": "#030712",
    "abyss": "#071426",
    "deep": "#0B1F3A",
    "tech": "#075985",
    "cyan": "#00D9FF",
    "glow": "#67F3FF",
    "electric": "#168BFF",
    "ice": "#DCEEFF",
    "dim_text": "#7F9BB7",
    "alert": "#FFB547",
    "error": "#FF5D73",
    "ultron": "#FF1F3D",
    "ultron_wine": "#4A0712",
    "ultron_metal": "#8C929C",
    "ultron_glow": "#FF5A6B"
  },
  "glass": {
    "fill": "rgba(6, 20, 40, 0.42)",
    "edge": "rgba(120, 220, 255, 0.22)",
    "blur": "10px"
  },
  "font": {
    "family": "\"Segoe UI\", \"Bahnschrift\", \"Roboto\", \"Helvetica Neue\", Arial, sans-serif",
    "mono": "Consolas, \"Cascadia Mono\", Menlo, monospace",
    "label_spacing": "3px",
    "size_xs": "10px",
    "size_s": "12px",
    "size_m": "15px",
    "size_l": "20px"
  },
  "radius": { "s": "6px", "m": "10px", "l": "16px" },
  "space": { "xs": "4px", "s": "8px", "m": "14px", "l": "22px", "xl": "32px" },
  "motion": { "fast": "160ms", "base": "300ms", "slow": "600ms", "ease": "cubic-bezier(.2,.7,.2,1)" },
  "state": {
    "online": "#3DFFA8",
    "offline": "#7F9BB7",
    "pending": "#FFB547",
    "failed": "#FF5D73"
  }
}
