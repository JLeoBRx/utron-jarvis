{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAFRA PoC",
  "version": "0.1.0",
  "identifier": "dev.safra.poc",
  "build": { "frontendDist": "../poc-ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "SAFRA — prova de conceito (Tauri)", "width": 960, "height": 640, "minWidth": 360, "minHeight": 480 }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
